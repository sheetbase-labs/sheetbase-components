{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@sheetbase-labs/sheetbase-shared": ["../shared/src/index.ts"],
      "@sheetbase-labs/sheetbase-table": ["../table/src/index.ts"],
      "@sheetbase-labs/sheetbase-explorer": ["../explorer/src/index.ts"],
      "@sheetbase-labs/sheetbase-advanced-search": ["../advanced-search/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.lib.config.ts", "vite.standalone.config.ts"]
}
