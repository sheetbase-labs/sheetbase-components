{
  "name": "@sheetbase-labs/sheetbase-explorer",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetbase-labs/sheetbase-components.git",
    "directory": "packages/explorer"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "version": "0.1.0",
  "type": "module",
  "main": "./dist-lib/sheetbase-explorer.js",
  "module": "./dist-lib/sheetbase-explorer.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-lib/sheetbase-explorer.js"
    },
    "./styles.css": "./dist-lib/style.css"
  },
  "files": [
    "dist-lib",
    "dist-types",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "budget": "node scripts/bundle-budget.mjs",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@tanstack/charts": "0.18.0",
    "alasql": "^4.6.6",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "papaparse": "^5.5.3",
    "@sheetbase-labs/sheetbase-shared": "workspace:*",
    "@sheetbase-labs/sheetbase-table": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.0",
    "@types/d3-shape": "^3.1.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
