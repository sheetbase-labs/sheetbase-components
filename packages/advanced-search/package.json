{
  "name": "@sheetbase-labs/sheetbase-advanced-search",
  "version": "0.6.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetbase-labs/sheetbase-components.git",
    "directory": "packages/advanced-search"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist-lib/sheetbase-advanced-search.js",
  "module": "./dist-lib/sheetbase-advanced-search.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-lib/sheetbase-advanced-search.js"
    },
    "./styles.css": "./dist-lib/style.css"
  },
  "files": ["dist-lib", "dist-types", "README.md"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@sheetbase-labs/sheetbase-shared": "workspace:*",
    "@sheetbase-labs/sheetbase-table": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
