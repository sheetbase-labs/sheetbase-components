{
  "name": "sheetbase-table",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist-lib/sheetbase-table.js",
  "module": "./dist-lib/sheetbase-table.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-lib/sheetbase-table.js"
    },
    "./styles.css": "./dist-lib/style.css"
  },
  "files": ["dist-lib", "dist-types", "README.md"],
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "vite",
    "dev:api": "bun examples/million-row-api.ts",
    "dev:herdr": "bash scripts/dev-herdr.sh",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node scripts/bundle-budget.mjs",
    "test:e2e:chromium": "playwright test --project=chromium",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "rbush": "^4.0.1",
    "sheetbase-shared": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
