{
  "name": "sheetbase-shared",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist-lib/sheetbase-shared.js",
  "module": "./dist-lib/sheetbase-shared.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist-lib/sheetbase-shared.js"
    },
    "./theme.css": "./src/theme.css",
    "./shell.css": "./src/shell.css",
    "./panes.css": "./src/panes/panes.css",
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "files": ["dist-lib", "dist-types", "src", "README.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "bun run build:lib",
    "test:watch": "vitest",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
