{
  "name": "@sheetbase-labs/sheetbase-shared",
  "version": "0.6.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetbase-labs/sheetbase-components.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "main": "./dist-lib/sheetbase-shared.js",
  "module": "./dist-lib/sheetbase-shared.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-lib/sheetbase-shared.js"
    },
    "./theme.css": "./src/theme.css",
    "./themes/v3.css": "./src/themes/v3.css",
    "./shell.css": "./src/shell.css",
    "./panes.css": "./src/panes/panes.css",
    "./styles.css": "./dist-lib/style.css",
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "files": ["dist-lib", "dist-types", "src", "README.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "bun run build:lib",
    "test:watch": "vitest",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
